+    def drop_empty_normalized_supervisions(self, cut: Cut):
+        """Drop supervisions whose text becomes empty/whitespace after normalization.
+
+        These segments (SBC-style fillers "um"/"mhm"/"<LAUGH>"/"<UNK>", etc.) carry no target
+        transcript but would still contribute speaker activity to the STNO diarization mask the
+        model conditions on -- causing a mismatch between the mask and the transcription, and
+        scoring empty reference speakers. Removing them here keeps the mask, the conditioning and
+        the scored reference consistent. No-op when keep_silent_speakers is set."""
+        if self.keep_silent_speakers:
