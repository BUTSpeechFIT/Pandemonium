[Unit]
Description=Pandemonium demo (Gradio, behind nginx at /pandemonium/)
RequiresMountsFor=/home
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ipoloka
Group=ipoloka
WorkingDirectory=/home/ipoloka/Pandemonium/demo/
StandardOutput=append:/home/ipoloka/.config/pandemonium-demo/service.out
StandardError=append:/home/ipoloka/.config/pandemonium-demo/service.err
ExecStart=/home/ipoloka/Pandemonium/demo/deploy/run_server.sh
PrivateTmp=true
Restart=always
RestartSec=10

# Sandbox: a compromise (e.g. through a crafted upload) reaches only what the demo itself needs.
# The home folder is replaced by an empty read-only one holding just these four folders, so SSH keys,
# the Hugging Face token and other projects do not exist for it; the docker socket (the user is in the
# docker group, i.e. root-equivalent) is hidden; nothing can gain privileges or write outside its folder
# and private /tmp. No PrivateDevices (the GPU needs /dev/nvidia*), no MemoryDenyWriteExecute (Triton JIT).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/ipoloka/Pandemonium/demo /home/ipoloka/miniconda3 /home/ipoloka/.cache/huggingface/hub
BindPaths=/home/ipoloka/.config/pandemonium-demo
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
